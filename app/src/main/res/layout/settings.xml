                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/music_title" android:textAppearance="@style/SettingsTitle" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/music_sources" android:textAppearance="@style/SettingsBody" />
                <TextView android:id="@+id/music_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/music_needed" android:textAppearance="@style/SettingsBody" android:accessibilityLiveRegion="polite" />
