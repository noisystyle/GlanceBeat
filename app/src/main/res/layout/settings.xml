<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settings_root" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:id="@+id/settings_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/settings_kicker" android:textSize="11sp" android:letterSpacing="0.13" android:textColor="?attr/colorPrimary" android:fontFamily="sans-serif-medium" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/settings_title" android:textSize="38sp" android:lineHeight="44sp" android:fontFamily="sans-serif-medium" android:textColor="?attr/colorOnSurface" android:accessibilityHeading="true" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="28dp" android:text="@string/settings_intro" android:textAppearance="@style/SettingsBody" />
        <com.google.android.material.card.MaterialCardView style="@style/SettingsCard" android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="32dp" app:cardBackgroundColor="?attr/colorSecondaryContainer">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="24dp" android:orientation="vertical">
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/player_enabled" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/enable_player" android:textSize="22sp" android:fontFamily="sans-serif-medium" android:textColor="?attr/colorOnSecondaryContainer" android:saveEnabled="false" />
                <TextView android:id="@+id/player_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/player_off" android:textAppearance="@style/SettingsBody" android:textColor="?attr/colorOnSecondaryContainer" android:accessibilityLiveRegion="polite" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.button.MaterialButton android:id="@+id/preview_player" style="@style/Widget.Material3Expressive.Button" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="12dp" android:layout_marginBottom="28dp" android:text="@string/preview" android:textSize="16sp" app:icon="@drawable/ic_play" app:iconGravity="textStart" app:cornerRadius="24dp" />
        <com.google.android.material.card.MaterialCardView style="@style/SettingsCard" android:layout_width="match_parent" android:layout_height="wrap_content">
