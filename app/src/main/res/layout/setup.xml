<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/setup_root" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:id="@+id/setup_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:orientation="vertical" android:padding="24dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/app_name" android:textAppearance="@style/TextAppearance.Material3.DisplaySmall" android:textColor="?attr/colorOnSurface" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/setup_intro" android:textAppearance="@style/SettingsBody" />
            <TextView android:id="@+id/setup_step" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:textAppearance="@style/TextAppearance.Material3.LabelLarge" android:textColor="?attr/colorPrimary" android:accessibilityLiveRegion="polite" />
            <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/setup_progress" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="12dp" android:max="100" android:importantForAccessibility="no" app:trackCornerRadius="4dp" app:trackThickness="8dp" />
            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" app:cardCornerRadius="32dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
                    <TextView android:id="@+id/setup_permission_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/SettingsTitle" android:accessibilityHeading="true" />
                    <TextView android:id="@+id/setup_permission_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textAppearance="@style/SettingsBody" />
                    <TextView android:id="@+id/setup_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:textAppearance="@style/TextAppearance.Material3.LabelLarge" android:textColor="?attr/colorPrimary" android:accessibilityLiveRegion="polite" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/setup_permission" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="16dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/setup_restricted_help" android:textAppearance="@style/TextAppearance.Material3.BodySmall" android:textColor="?attr/colorOnSurfaceVariant" />
            <com.google.android.material.button.MaterialButton android:id="@+id/setup_next" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="60dp" android:layout_marginTop="24dp" app:icon="@drawable/ic_arrow_right" app:iconGravity="textEnd" />
            <com.google.android.material.button.MaterialButton android:id="@+id/setup_back" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/setup_back" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/setup_optional" android:textAppearance="@style/TextAppearance.Material3.BodySmall" android:textColor="?attr/colorOnSurfaceVariant" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/unlock_title" android:textAppearance="@style/TextAppearance.Material3.TitleMedium" android:textColor="?attr/colorOnSurface" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="24dp" android:text="@string/unlock_body" android:textAppearance="@style/SettingsBody" />
        </LinearLayout>
    </FrameLayout>
</androidx.core.widget.NestedScrollView>
