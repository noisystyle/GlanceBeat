<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <FrameLayout android:id="@+id/seek_touch" android:layout_width="match_parent" android:layout_height="48dp" android:visibility="invisible" android:importantForAccessibility="no">
    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/track_progress" style="@style/Widget.Material3Expressive.LinearProgressIndicator.Wavy" android:layout_width="match_parent" android:layout_height="24dp" android:max="10000" android:indeterminate="false" android:contentDescription="@string/playback_progress" app:hideAnimationBehavior="none" app:showAnimationBehavior="none" />
    </FrameLayout>
    <TextView android:id="@+id/track_elapsed" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:visibility="invisible" android:importantForAccessibility="no" />
    <TextView android:id="@+id/track_duration" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:visibility="invisible" android:importantForAccessibility="no" />
    <com.google.android.material.button.MaterialButton android:id="@+id/like_track" style="@style/Widget.Material3Expressive.Button.IconButton.Tonal" android:layout_width="48dp" android:layout_height="48dp" android:insetLeft="0dp" android:insetRight="0dp" android:contentDescription="@string/like" android:tooltipText="@string/like" android:visibility="invisible" app:icon="@drawable/ic_thumb_up" app:iconPadding="0dp" app:iconGravity="textStart" />
    <com.google.android.material.button.MaterialButton android:id="@+id/dislike_track" style="@style/Widget.Material3Expressive.Button.IconButton.Tonal" android:layout_width="48dp" android:layout_height="48dp" android:insetLeft="0dp" android:insetRight="0dp" android:contentDescription="@string/dislike" android:tooltipText="@string/dislike" android:visibility="invisible" app:icon="@drawable/ic_thumb_down" app:iconPadding="0dp" app:iconGravity="textStart" />
    <com.google.android.material.button.MaterialButton android:id="@+id/shuffle_queue" style="@style/Widget.Material3Expressive.Button.IconButton.Tonal" android:layout_width="48dp" android:layout_height="48dp" android:insetLeft="0dp" android:insetRight="0dp" android:contentDescription="@string/enable_shuffle" android:tooltipText="@string/enable_shuffle" android:visibility="invisible" app:icon="@drawable/ic_shuffle" app:iconPadding="0dp" app:iconGravity="textStart" />
</merge>
